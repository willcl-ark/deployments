+// Copyright 2026 The Forgejo Authors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package permissions
+
+import (
+	"net/http"
+	"testing"
+
+	"forgejo.org/models/perm"
+	access_model "forgejo.org/models/perm/access"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unit"
+)
+
+func TestMetadataMirrorPullPermissions(t *testing.T) {
+	for _, test := range []struct {
+		name                                           string
+		mirror, metadata, empty, readPulls, readIssues bool
+		pullsAllowed, issuesOrPullsAllowed             bool
+	}{
+		{name: "ordinary repository", readPulls: true, pullsAllowed: true, issuesOrPullsAllowed: true},
+		{name: "metadata mirror", mirror: true, metadata: true, readPulls: true, pullsAllowed: true, issuesOrPullsAllowed: true},
+		{name: "plain mirror", mirror: true, readPulls: true},
+		{name: "empty metadata mirror", mirror: true, metadata: true, empty: true, readPulls: true},
+		{name: "metadata mirror without read access", mirror: true, metadata: true},
+		{name: "issue access only", mirror: true, metadata: true, readIssues: true, issuesOrPullsAllowed: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for _, check := range []struct {
+				name    string
+				fn      func(Context)
+				allowed bool
+			}{
+				{"pulls", MustAllowPulls, test.pullsAllowed},
+				{"issues or pulls", MustEnableIssuesOrPulls, test.issuesOrPullsAllowed},
+			} {
+				t.Run(check.name, func(t *testing.T) {
+					ctx := &Permissions{}
+					ctx.SetRepository(&repo_model.Repository{IsMirror: test.mirror, IsEmpty: test.empty})
+					ctx.SetIsGitHubMetadataMirror(test.metadata)
+					modes := map[unit.Type]perm.AccessMode{}
+					if test.readPulls {
+						modes[unit.TypePullRequests] = perm.AccessModeRead
+					}
+					if test.readIssues {
+						modes[unit.TypeIssues] = perm.AccessModeRead
+					}
+					ctx.SetPermission(&access_model.Permission{UnitsMode: modes})
+					check.fn(ctx)
+					want := http.StatusNotFound
+					if check.allowed {
+						want = 0
+					}
+					if got := ctx.WrittenStatus(); got != want {
+						t.Fatalf("status = %d, want %d", got, want)
+					}
+				})
+			}
+		})
+	}
+}
