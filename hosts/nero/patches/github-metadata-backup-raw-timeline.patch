+#[cfg(test)]
+mod timeline_tests {
+    use super::*;
+    use std::io::{Read, Write};
+    use std::net::TcpListener;
+
+    #[tokio::test]
+    async fn preserves_unknown_timeline_events() {
+        let event = serde_json::json!({
+            "id": 123, "event": "blocked_by_added",
+            "created_at": "2026-10-31T00:00:00Z",
+            "actor": {"login": "example", "id": 1},
+            "dependency": {"number": 753, "future_field": true}
+        });
+        let body = serde_json::to_string(&vec![event.clone()]).unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut request = Vec::new();
+            let mut byte = [0];
+            while !request.ends_with(b"\r\n\r\n") {
+                stream.read_exact(&mut byte).unwrap();
+                request.push(byte[0]);
+            }
+            let request = String::from_utf8(request).unwrap();
+            assert!(request.starts_with("GET /repos/bitcoin-core/gui-qml/issues/753/timeline?"));
+            assert!(request.contains("page=2"));
+            assert!(request.contains("per_page=100"));
+            write!(stream, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", body.len(), body).unwrap();
+        });
+        octocrab::initialise(
+            octocrab::OctocrabBuilder::default()
+                .base_uri(format!("http://{address}"))
+                .unwrap()
+                .build()
+                .unwrap(),
+        );
+        let page = get_timeline_page(753, 2, "bitcoin-core".into(), "gui-qml".into(), 0)
+            .await
+            .unwrap();
+        assert_eq!(
+            serde_json::to_value(&page.items).unwrap(),
+            serde_json::json!([event])
+        );
+        assert!(page.next.is_none());
+        server.join().unwrap();
+    }
+}
