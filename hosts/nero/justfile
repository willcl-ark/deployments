set shell := ["bash", "-euc"]

target := "root@nero"
ssh_port := "2222"

# List Nero commands.
[private]
default:
    @just --list

# Open an SSH session.
ssh:
    ssh -p {{ ssh_port }} {{ target }}

# Follow DNS seed logs.
logs network="mainnet":
    ssh -p {{ ssh_port }} {{ target }} {{ quote("systemctl status dnsseedrs-" + quote(network) + " && journalctl -f -u dnsseedrs-" + quote(network)) }}

logs-ralph:
    ssh -p {{ ssh_port }} {{ target }} 'systemctl status ralph && journalctl -f -u ralph -n 10'

# Count DNS seed nodes.
db-stats network="mainnet":
    ssh -p {{ ssh_port }} {{ target }} {{ quote("nix shell --quiet nixpkgs#sqlite -c sqlite3 " + quote("/var/lib/dnsseedrs/" + network + "/sqlite.db") + " 'SELECT COUNT(*) FROM nodes;'") }}

# Test Guix offload connections.
guix-offload-test:
    ssh -p {{ ssh_port }} {{ target }} 'guix offload test'

# Follow Guix worker logs.
guix-worker-logs:
    ssh -p {{ ssh_port }} {{ target }} 'systemctl status guix-bitcoin-worker.service --no-pager || true; journalctl -fu guix-bitcoin-worker.service'

# Start the Guix worker now.
guix-worker-start:
    ssh -p {{ ssh_port }} {{ target }} 'systemctl start --no-block guix-bitcoin-worker.service'

# Show queued and running Guix jobs.
guix-queue:
    #!/usr/bin/env bash
    set -euo pipefail
    ssh -p {{ ssh_port }} {{ target }} '
        jobs_root=/gnu/guix-bitcoin/jobs
        worker_state=$(systemctl is-active guix-bitcoin-worker.service 2>/dev/null || true)
        printf "worker: %s\n" "${worker_state:-unknown}"
        for state in queued running; do
            printf "\n%s:\n" "$state"
            found=false
            for job in "$jobs_root/$state"/*; do
                [ -d "$job" ] || continue
                found=true
                printf "  %s\n" "${job##*/}"
                if [ -f "$job/source_repository" ] && [ -f "$job/source_commit" ]; then
                    printf "    source_repository=%s\n" "$(cat "$job/source_repository")"
                    printf "    source_commit=%s\n" "$(cat "$job/source_commit")"
                else
                    printf "    (missing source descriptor)\n"
                fi
            done
            [ "$found" = true ] || printf "  (empty)\n"
        done
    '

# Queue a commit for a Guix build.
guix-submit commit repository="https://github.com/bitcoin/bitcoin":
    @[[ {{ quote(commit) }} =~ ^[0-9a-f]{40}$ ]] || { echo "commit must be a full lowercase 40-character hash" >&2; exit 2; }
    ssh -p {{ ssh_port }} {{ target }} {{ quote("GUIX_BITCOIN_REPOSITORY=" + quote(repository) + " /run/current-system/sw/bin/guix-bitcoin-submit " + quote(commit)) }}
    ssh -p {{ ssh_port }} {{ target }} 'systemctl start --no-block guix-bitcoin-worker.service'

# Queue the latest Bitcoin Core master.
guix-submit-master:
    ssh -p {{ ssh_port }} {{ target }} 'systemctl start --no-block guix-bitcoin-nightly.service'
