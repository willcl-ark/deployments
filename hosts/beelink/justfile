set shell := ["bash", "-euc"]

target := "root@beelink"
units := "ci-runner.service ci-nightly-bitcoin-enqueue.service ci-watch-bitcoin-guix.service ci-watch-bitcoin-valgrind-fuzz.service ci-watch-bitcoin-bench.service ci-bitcoin-bench-run.service"

# List Beelink commands.
[private]
default:
    @just --list

# Open an SSH session.
ssh:
    ssh {{ target }}

# Follow CI service logs.
logs:
    ssh {{ target }} 'journalctl -f -o short-iso -u ci-runner.service -u ci-nightly-bitcoin-enqueue.service -u ci-watch-bitcoin-guix.service -u ci-watch-bitcoin-valgrind-fuzz.service -u ci-watch-bitcoin-bench.service -u ci-bitcoin-bench-run.service'

# Show CI service status.
status:
    ssh {{ target }} 'systemctl --no-pager --full status {{ units }}'

# Enqueue the nightly CI job now.
nightly-start:
    ssh {{ target }} 'systemctl start ci-nightly-bitcoin-enqueue.service'

# Queue a priority Guix build.
guix-submit revision description="":
    @[[ {{ quote(revision) }} =~ ^[0-9a-fA-F]{40}$ ]] || { echo "revision must be a full 40-character hexadecimal commit ID" >&2; exit 2; }
    ssh {{ target }} {{ quote("sudo -u ci-runner ci-runner --queue-dir /var/lib/ci-runner/queue enqueue bitcoin-guix --kind manual --revision " + quote(revision) + " --description " + quote(description)) }}

# Queue a benchmark run.
bench-submit revision:
    @[[ {{ quote(revision) }} =~ ^[0-9a-fA-F]{40}$ ]] || { echo "revision must be a full 40-character hexadecimal commit ID" >&2; exit 2; }
    ssh {{ target }} {{ quote("sudo -u ci-runner ci-runner --queue-dir /var/lib/ci-runner/queue enqueue bitcoin-bench --kind manual --revision " + quote(revision)) }}

# Show the CI job queue.
queue-status:
    ssh {{ target }} 'sudo -u ci-runner ci-runner --queue-dir /var/lib/ci-runner/queue status'

# Cancel a pending CI job.
queue-cancel job_id:
    ssh {{ target }} {{ quote("sudo -u ci-runner ci-runner --queue-dir /var/lib/ci-runner/queue cancel " + quote(job_id)) }}

# Start, stop or restart CI services.
services command:
    ssh {{ target }} {{ quote("systemctl " + quote(command) + " " + units) }}
